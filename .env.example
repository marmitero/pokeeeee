# ─────────────────────────────────────────────────────────────────────────────
# Pokémon Deluge RPG — variáveis de ambiente
#
# Copie este arquivo para `.env` e ajuste os valores:
#     cp .env.example .env
#
# ⚠️  `.env` está no `.gitignore` e NUNCA deve ser commitado.
# ─────────────────────────────────────────────────────────────────────────────

# String de conexão do PostgreSQL.
# Usada por src/db/index.ts (runtime) e por drizzle.config.ts (migrations/seed).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"
