# ─────────────────────────────────────────────────────────────────────────────
# Pokémon Deluge RPG — variáveis de ambiente
# Copie para `.env`; nunca commite valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime da aplicação.
# Local: conexão direta. Vercel: Session Pooler do Supabase, porta 5432.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Conexão usada somente por drizzle-kit/migrations. Em produção, use a conexão
# direta do Supabase. Se ausente, drizzle.config.ts usa DATABASE_URL como fallback.
# DIRECT_DATABASE_URL="postgresql://postgres:SENHA@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full"

# TLS é detectado automaticamente em hosts Supabase. Estes overrides raramente
# são necessários. Nunca desative a validação de certificado na Vercel.
# DATABASE_SSL="true"
# DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# Limites conservadores para runtime serverless. Os padrões de produção são
# max=3, conexão=10s e ociosidade=30s.
# DATABASE_POOL_MAX="3"
# DATABASE_CONNECTION_TIMEOUT_MS="10000"
# DATABASE_IDLE_TIMEOUT_MS="30000"

# Rate limit compartilhado entre instâncias.
RATE_LIMIT_STORE="postgres"

# Produção direta usa cookie HttpOnly de primeira parte.
COOKIE_SAME_SITE="lax"

# Bearer/localStorage é apenas para preview legado em iframe. Produção direta
# mantém desativado (padrão em NODE_ENV=production).
# SESSION_BEARER_ENABLED="false"

# Hosts extras aceitos apenas pelo `next dev`.
# ALLOWED_DEV_ORIGINS=""

# PostgreSQL administrativo usado pela suíte de integração local/CI.
# TEST_PG_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"
