# ─────────────────────────────────────────────────────────────────────────────
# Pokémon Deluge RPG — variáveis de ambiente
#
# Copie este arquivo para `.env` e ajuste os valores:
#     cp .env.example .env
#
# ⚠️  `.env` está no `.gitignore` e NUNCA deve ser commitado.
# ─────────────────────────────────────────────────────────────────────────────

# String de conexão do PostgreSQL.
# Usada por src/db/index.ts (runtime) e por drizzle.config.ts (migrations/seed).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# SameSite do cookie de sessão: "lax" (padrão) ou "none".
#
# Use "none" quando o app for acessado DENTRO DE UM IFRAME de outro site
# (é o caso do preview embutido). Com "lax" o navegador não reenvia o cookie
# em contexto de terceiro, e o login parece funcionar mas toda request
# seguinte devolve 401.
#
# "none" exige HTTPS e vem acompanhado da validação de Origin (src/lib/csrf.ts).
COOKIE_SAME_SITE="lax"
